# Copy to .env and fill in real values. Never commit .env.
# Scoped API tokens must use the api.atlassian.com gateway as base URL.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_BASE_URL=https://api.atlassian.com/ex/jira/your-cloud-id
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DP
JIRA_FIELD_SEVERITY=customfield_xxxxx
JIRA_FIELD_CAUSED_BY_DEPLOYMENT=customfield_xxxxx

# GitHub (fine-grained PAT, read-only, repo-scoped). Do not use the GITHUB_ prefix.
GH_API_TOKEN=
GH_API_OWNER=your-github-username
GH_API_REPO=devpulse
